{
  "id": "two_lines",
  "version": 1,
  "description": "Street line, then city/state/ZIP; short and expanded common suffix variants.",
  "case": "upper",
  "variants": [
    {"lines": ["{number} {street}", "{city}, {state} {zip}"]},
    {"lines": ["{number} {street}", "{city} {state} {zip}"],
